{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fault_history_agent 输出契约",
  "description": "workflow.run() 成功返回的 outputs[0]，同时原样落入 fault_history.json；所有内容为待人工审核的合成案例检索结果。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "problem_description",
    "requested_model_type",
    "findings",
    "refusals",
    "cross_model_matches",
    "human_review_required",
    "artifacts"
  ],
  "properties": {
    "problem_description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "requested_model_type": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "evidence",
          "confidence"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "source_ref",
                "quote",
                "resolved"
              ],
              "properties": {
                "kind": {
                  "const": "fault_case"
                },
                "source_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "resolved": {
                  "const": false
                }
              }
            }
          },
          "confidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "basis"
            ],
            "properties": {
              "level": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "basis": {
                "type": "string",
                "enum": [
                  "多案例",
                  "单源",
                  "推断"
                ]
              }
            }
          }
        }
      }
    },
    "refusals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "reason",
          "suggestion"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "suggestion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "cross_model_matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "fault_ref",
          "similarity_basis",
          "disposition_summary"
        ],
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "fault_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "similarity_basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "disposition_summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "human_review_required": {
      "const": true
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "enum": [
          "fault_history.json",
          "fault_history.md"
        ]
      },
      "uniqueItems": true
    }
  },
  "anyOf": [
    {
      "properties": {
        "findings": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "refusals": {
          "minItems": 1
        }
      }
    }
  ]
}

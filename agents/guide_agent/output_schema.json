{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "导引 Agent 计划（编排官裁决）",
  "description": "导引在对话中给出的结构化候选计划。Agent 字段由 workflow 对账 Registry + input_schema 后生成；平台可对认证 safe_auto 请求进行二次 admission 并自动创建安全任务，但 LLM 无执行/签发能力，最终工程签发权始终在人。",
  "definitions": {
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "request_id", "status", "plan_digest", "task_ids", "issues", "replayed"],
      "properties": {
        "mode": { "const": "safe_auto" },
        "request_id": { "type": "string" },
        "status": {
          "enum": ["dispatched", "blocked_input", "blocked_source", "blocked_policy", "blocked_conflict", "awaiting_plan", "refused"]
        },
        "plan_digest": { "type": ["string", "null"] },
        "task_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        },
        "replayed": { "type": "boolean" },
        "graph_version": { "const": "guide_dag.v1" },
        "graph_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "node_tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "agent_id", "task_id", "initial_status"],
            "properties": {
              "node_id": { "type": "string" },
              "agent_id": { "type": "string" },
              "task_id": { "type": "string" },
              "initial_status": { "enum": ["queued", "created"] }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "contract", "analysis", "goal", "workflow", "nodes", "dropped_agents", "capped"],
      "properties": {
        "decision": { "const": "orchestrate" },
        "contract": { "const": "guide_dag.v1" },
        "analysis": { "type": "string" },
        "goal": { "type": "string" },
        "workflow": { "type": "string" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "agent_id", "agent_version", "agent_name", "category", "status", "maturity", "role", "rationale", "prefilled_inputs", "stripped_fields", "depends_on", "artifact_binding", "attachment_binding"],
            "properties": {
              "node_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
              "agent_id": { "type": "string" },
              "agent_version": { "type": "string" },
              "agent_name": { "type": "string" },
              "category": { "type": "string" },
              "status": { "type": "string" },
              "maturity": { "type": "string" },
              "role": { "type": "string" },
              "rationale": { "type": "string" },
              "prefilled_inputs": { "type": "object" },
              "stripped_fields": { "type": "array", "maxItems": 0 },
              "depends_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "artifact_binding": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "from_nodes"],
                "properties": {
                  "mode": { "enum": ["none", "all", "selected"] },
                  "from_nodes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
                }
              },
              "attachment_binding": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode"],
                "properties": {
                  "mode": { "enum": ["none", "current_turn"] }
                }
              }
            }
          }
        },
        "dropped_agents": { "type": "array", "maxItems": 0 },
        "capped": { "const": false },
        "execution": {
          "allOf": [
            { "$ref": "#/definitions/execution" },
            {
              "if": {
                "required": ["status"],
                "properties": { "status": { "const": "dispatched" } }
              },
              "then": {
                "required": ["graph_version", "graph_digest", "node_tasks"]
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "analysis", "goal", "workflow", "agents", "dropped_agents", "capped"],
      "properties": {
        "decision": { "const": "orchestrate", "description": "裁决：平台有合适 Agent，召集协作。" },
        "analysis": { "type": "string", "description": "导引对任务的最终分析（LLM 提供，供人核对）。" },
        "goal": { "type": "string", "description": "目标陈述；自动派发只物化安全任务，不构成工程签发。" },
        "workflow": { "type": "string", "description": "协作方式/分工如何衔接（LLM 提供，供人核对）。" },
        "agents": {
          "type": "array",
          "description": "召集的 Agent（每个都已确定性对账：Registry 真实、非 disabled/interactive/自身；预填逐字段过 input_schema）。至少 1 个，至多 5 个（超出截断，见 capped）。",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["agent_id", "agent_version", "agent_name", "category", "status", "maturity", "role", "rationale", "prefilled_inputs", "stripped_fields"],
            "properties": {
              "agent_id": { "type": "string", "description": "召集的 specialist Agent id（已校验真实/可召集）。" },
              "agent_version": { "type": "string", "description": "确定性校验时锁定的 Agent 版本；自动派发前必须与 Registry 当前版本一致。" },
              "agent_name": { "type": "string", "description": "目标 Agent 显示名（取自 Registry）。" },
              "category": { "type": "string", "description": "目标 Agent 类型（取自 Registry）。" },
              "status": { "type": "string", "description": "目标 Agent 状态（draft/trial/released）。" },
              "maturity": { "type": "string", "description": "目标 Agent 成熟度（L0-L3）。" },
              "role": { "type": "string", "description": "该 Agent 在本次协作中的分工（LLM 提供）。" },
              "rationale": { "type": "string", "description": "召集它的理由（LLM 提供，仅参考）。" },
              "prefilled_inputs": { "type": "object", "description": "输入候选——逐字段已校验但可能不完整；safe_auto 会再做完整 schema 与来源校验，缺失则零任务阻断。" },
              "stripped_fields": { "type": "array", "items": { "type": "string" }, "description": "LLM 提议但被剥离的字段名（未声明或违反字段 schema），如实记名。" }
            }
          }
        },
        "dropped_agents": { "type": "array", "items": { "type": "string" }, "description": "LLM 提议但被剥离的 agent_id（幻觉/disabled/interactive/自身/重复），如实记名不隐藏。" },
        "capped": { "type": "boolean", "description": "是否因超过召集上限（5 个）而截断。" },
        "execution": { "$ref": "#/definitions/execution", "description": "平台在持久化/响应阶段追加的执行事实；workflow/LLM 不生成。" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason", "residual_problems", "reframe"],
      "properties": {
        "decision": { "const": "refuse", "description": "裁决：平台没有合适 Agent（甚至不值得为此建专用 Agent），显式拒绝。" },
        "reason": { "type": "string", "description": "为何不适合（LLM 提供）。" },
        "residual_problems": { "type": "array", "items": { "type": "string" }, "description": "即便拒绝后，用户手上仍未解决的问题（LLM 提供，供人另寻出路）。" },
        "reframe": { "type": "array", "items": { "type": "string" }, "description": "如何重述/拆解需求才可能被平台接住（LLM 提供的建设性建议）。" },
        "execution": { "$ref": "#/definitions/execution", "description": "平台追加的拒绝执行事实；workflow/LLM 不生成。" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "execution"],
      "properties": {
        "decision": { "const": "awaiting_plan", "description": "平台专属投影：导引仍在澄清，尚无候选计划。workflow/LLM 不生成。" },
        "execution": { "$ref": "#/definitions/execution", "description": "持久化的 safe_auto 等待计划回执。" }
      }
    }
  ]
}

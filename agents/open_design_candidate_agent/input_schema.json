{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "open_design_candidate_agent fixed fixture request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_request",
    "design_reference_package",
    "open_design_protocol",
    "interaction_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "open-design-fixture-request/v1"
    },
    "asset_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "formats",
        "intent",
        "locale"
      ],
      "properties": {
        "asset_id": {
          "const": "task-review-summary"
        },
        "formats": {
          "const": [
            "html",
            "svg"
          ]
        },
        "intent": {
          "const": "以手工 machine-only 协议契约夹具验证 FLAi-OS 设计引用包传递；不是 Open Design 生产生成或视觉 QA"
        },
        "locale": {
          "const": "zh-CN"
        }
      }
    },
    "design_reference_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "package_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "flai-design-reference-package/v1"
        },
        "package_sha256": {
          "const": "4fa241ae49d3c992168b2589779e24344749300a129e1f9478337974a3d68ca3"
        }
      }
    },
    "open_design_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations",
        "source",
        "source_sha256",
        "upstream_revision",
        "write_operations",
        "read_operations"
      ],
      "properties": {
        "operations": {
          "const": [
            "create_project",
            "start_run",
            "get_run",
            "get_artifact"
          ]
        },
        "source": {
          "const": "apps/daemon/src/mcp.ts"
        },
        "source_sha256": {
          "const": "6f8f4a02984604418a829952114875a7ce364eb62abd36493dbd4c4e5b57341a"
        },
        "upstream_revision": {
          "const": "e06bff69"
        },
        "write_operations": {
          "const": [
            "create_project",
            "start_run"
          ]
        },
        "read_operations": {
          "const": [
            "get_run",
            "get_artifact"
          ]
        }
      }
    },
    "interaction_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_only",
        "human_review_required",
        "release_effect",
        "rendering"
      ],
      "properties": {
        "candidate_only": {
          "const": true
        },
        "human_review_required": {
          "const": true
        },
        "release_effect": {
          "const": "none"
        },
        "rendering": {
          "const": "static_no_script_no_iframe"
        }
      }
    }
  }
}

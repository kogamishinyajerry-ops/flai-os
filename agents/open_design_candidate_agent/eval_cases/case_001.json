{
  "case_id": "case_001",
  "description": "固定 Open Design fixture 请求应生成六个候选/追溯产物，并停在 waiting_review；任何设计 SSOT 或 fixture 字节漂移由工具 fail-closed。",
  "inputs": {
    "schema_version": "open-design-fixture-request/v1",
    "asset_request": {
      "asset_id": "task-review-summary",
      "formats": [
        "html",
        "svg"
      ],
      "intent": "以手工 machine-only 协议契约夹具验证 FLAi-OS 设计引用包传递；不是 Open Design 生产生成或视觉 QA",
      "locale": "zh-CN"
    },
    "design_reference_package": {
      "schema_version": "flai-design-reference-package/v1",
      "package_sha256": "4fa241ae49d3c992168b2589779e24344749300a129e1f9478337974a3d68ca3"
    },
    "open_design_protocol": {
      "operations": [
        "create_project",
        "start_run",
        "get_run",
        "get_artifact"
      ],
      "source": "apps/daemon/src/mcp.ts",
      "source_sha256": "6f8f4a02984604418a829952114875a7ce364eb62abd36493dbd4c4e5b57341a",
      "upstream_revision": "e06bff69",
      "write_operations": [
        "create_project",
        "start_run"
      ],
      "read_operations": [
        "get_run",
        "get_artifact"
      ]
    },
    "interaction_contract": {
      "candidate_only": true,
      "human_review_required": true,
      "release_effect": "none",
      "rendering": "static_no_script_no_iframe"
    }
  },
  "expected": {
    "task_status": "waiting_review",
    "mock": true,
    "candidate_only": true,
    "candidate_count": 2
  },
  "checks": [
    {
      "kind": "status_is",
      "value": "waiting_review"
    },
    {
      "kind": "artifact_exists",
      "file": "OPEN_DESIGN_REVIEW.md"
    },
    {
      "kind": "artifact_exists",
      "file": "flai_design_reference_package.json"
    },
    {
      "kind": "artifact_contains",
      "file": "open_design_provenance.json",
      "value": "candidate_only"
    }
  ]
}

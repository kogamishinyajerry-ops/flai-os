{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "生活场景建模主持人单轮输出",
  "description": "主持人每轮输出对话回复与可选的严格九字段模型提议。记录身份、digest 与 lineage 必须由 ConversationService 在原子事务内建立，workflow 无权自报。",
  "type": "object",
  "additionalProperties": false,
  "required": ["assistant_message", "generalization_draft"],
  "properties": {
    "assistant_message": {
      "type": "string",
      "description": "主持人对用户说的话(追问、引导、或展示草稿摘要)。"
    },
    "generalization_draft": {
      "type": ["object", "null"],
      "description": "当对话已能投影出 Generalization 时,这里是 9 字段结构(title/trigger/desired_outcome/inputs/outputs/steps/evidence_requirements/human_decision_points/limitations);否则为 null,表示仍需在对话里补料。",
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "trigger": {"type": "string"},
        "desired_outcome": {"type": "string"},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "outputs": {"type": "array", "items": {"type": "string"}},
        "steps": {"type": "array", "items": {"type": "string"}},
        "evidence_requirements": {"type": "array", "items": {"type": "string"}},
        "human_decision_points": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "required": [
        "title", "trigger", "desired_outcome", "inputs", "outputs",
        "steps", "evidence_requirements", "human_decision_points", "limitations"
      ]
    }
  }
}

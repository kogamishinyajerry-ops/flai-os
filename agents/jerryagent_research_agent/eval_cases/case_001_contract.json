    {"kind": "task_field", "path": "data_classification", "op": "eq", "value": "sensitive"},
    {"kind": "artifact_exists", "file": "jerryagent_result.md"},
    {"kind": "artifact_contains", "file": "jerryagent_result.md", "value": "Candidate only: `true`"},
    {"kind": "artifact_contains", "file": "jerryagent_result.md", "value": "FLAi model-call attestation: `false`"}
  ]

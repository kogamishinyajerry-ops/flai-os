    { "kind": "output_field", "file": "evaluation.json", "path": "upstream_converged", "op": "eq", "value": true },
    { "kind": "output_field", "file": "evaluation.json", "path": "error_pct", "op": "lte", "value": 0.01 },
    { "kind": "artifact_contains", "file": "evaluation.md", "value": "判定权在人" },
    { "kind": "artifact_contains", "file": "evaluation.md", "value": "一致" }
  ]

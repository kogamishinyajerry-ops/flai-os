{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flai:schema:review-package:f0-review-manifest-v1",
  "title": "F0ReviewManifestV1",
  "description": "Review-package-only schema. This is not a production schema and does not authorize F1 or any runtime change.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_manifest_schema_version",
    "review_manifest_ref",
    "repository_identity",
    "frozen_git_commit_sha",
    "frozen_git_tree_sha",
    "normative_files",
    "review_record_schema_version",
    "supersedes_review_manifest_ref",
    "supersedes_review_manifest_digest",
    "created_at",
    "review_manifest_digest"
  ],
  "properties": {
    "review_manifest_schema_version": {
      "const": "F0ReviewManifestV1"
    },
    "review_manifest_ref": {
      "type": "string",
      "pattern": "^flai://f0-review-manifest/sha256/[0-9a-f]{64}$"
    },
    "repository_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vcs",
        "provider",
        "host",
        "repository_owner",
        "repository_name",
        "canonical_remote"
      ],
      "properties": {
        "vcs": {
          "const": "git"
        },
        "provider": {
          "const": "github"
        },
        "host": {
          "const": "github.com"
        },
        "repository_owner": {
          "const": "kogamishinyajerry-ops"
        },
        "repository_name": {
          "const": "flai-os"
        },
        "canonical_remote": {
          "const": "https://github.com/kogamishinyajerry-ops/flai-os.git"
        }
      }
    },
    "frozen_git_commit_sha": {
      "$ref": "#/$defs/gitOid"
    },
    "frozen_git_tree_sha": {
      "$ref": "#/$defs/gitOid"
    },
    "normative_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/normativeFile"
      },
      "description": "The review-package verifier, not JSON Schema alone, MUST reject duplicate paths and require strict ascending UTF-8 byte ordering by repository_relative_path."
    },
    "review_record_schema_version": {
      "const": "F0NamedReviewV1"
    },
    "supersedes_review_manifest_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^flai://f0-review-manifest/sha256/[0-9a-f]{64}$"
    },
    "supersedes_review_manifest_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "#/$defs/utcSecondTimestamp"
    },
    "review_manifest_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "supersedes_review_manifest_ref": {
              "type": "null"
            },
            "supersedes_review_manifest_digest": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "supersedes_review_manifest_ref": {
              "type": "string"
            },
            "supersedes_review_manifest_digest": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "gitOid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utcSecondTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])T([0-1][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*//)(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\\/$)[^\\u0000]+$",
      "description": "Must additionally be NFC. Ordering is by the UTF-8 byte sequence of this exact string."
    },
    "normativeRole": {
      "enum": [
        "DOMAIN_CONTEXT",
        "ARCHITECTURE_DECISION_RECORD",
        "DESIGN_PACKAGE_INDEX",
        "DESIGN_CONTRACT",
        "IMPLEMENTATION_HANDOFF_CONTRACT",
        "REVIEW_PACKAGE_SCHEMA"
      ]
    },
    "normativeFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_relative_path",
        "git_blob_oid",
        "git_file_mode",
        "sha256",
        "normative_role"
      ],
      "properties": {
        "repository_relative_path": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "git_blob_oid": {
          "$ref": "#/$defs/gitOid"
        },
        "git_file_mode": {
          "enum": [
            "100644",
            "100755"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256",
          "description": "SHA-256 of the exact raw Git blob bytes. No text, Unicode, BOM, line-ending, whitespace or permission normalization is permitted."
        },
        "normative_role": {
          "$ref": "#/$defs/normativeRole"
        }
      }
    }
  },
  "$comment": "Digest: lowercase_hex(SHA-256(ASCII('flai.feishu-hub.f0-review-manifest.v1') || 0x00 || RFC8785_JCS_UTF8(NFC-validated object excluding exactly review_manifest_ref and review_manifest_digest))). review_manifest_ref MUST equal 'flai://f0-review-manifest/sha256/' plus that digest. The verifier MUST also check the fixed repository identity, root tree, raw Git blobs, required normative path coverage, strict path ordering, no duplicate paths, supersedes ref/digest consistency, no floats and NFC strings."
}

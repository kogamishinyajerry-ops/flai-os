{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generalization_draft_record.schema.json",
  "title": "Canonical Generalization Draft Record public projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "payload_schema_version",
    "state",
    "review_status",
    "payload",
    "content_digest",
    "record_digest",
    "source_context_digest",
    "model_attribution",
    "lineage",
    "created_at"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^gdr_[0-9a-f]{32}$"},
    "schema_version": {"const": "generalization_draft_record.v1"},
    "payload_schema_version": {"const": "life_generalization.v1"},
    "state": {"const": "model_draft"},
    "review_status": {"const": "waiting_review"},
    "payload": {"$ref": "#/$defs/payload"},
    "content_digest": {"$ref": "#/$defs/digest"},
    "record_digest": {"$ref": "#/$defs/digest"},
    "source_context_digest": {"$ref": "#/$defs/digest"},
    "model_attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_call_id",
        "kind",
        "agent_id",
        "agent_version",
        "profile",
        "model_name"
      ],
      "properties": {
        "model_call_id": {"type": "integer", "minimum": 1},
        "kind": {"const": "chat"},
        "agent_id": {"const": "life_guide_agent"},
        "agent_version": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "model_name": {"type": "string", "minLength": 1}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "user_message_id",
        "assistant_message_id",
        "task_id"
      ],
      "properties": {
        "conversation_id": {"type": "string", "minLength": 1},
        "user_message_id": {"type": "integer", "minimum": 1},
        "assistant_message_id": {"type": "integer", "minimum": 1},
        "task_id": {"type": "null"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonBlankText": {
      "type": "string",
      "minLength": 1
    },
    "textList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "trigger",
        "desired_outcome",
        "inputs",
        "outputs",
        "steps",
        "evidence_requirements",
        "human_decision_points",
        "limitations"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "trigger": {"type": "string", "minLength": 1, "maxLength": 2000},
        "desired_outcome": {"type": "string", "minLength": 1, "maxLength": 2000},
        "inputs": {"$ref": "#/$defs/textList"},
        "outputs": {"$ref": "#/$defs/textList"},
        "steps": {
          "allOf": [
            {"$ref": "#/$defs/textList"},
            {"minItems": 2}
          ]
        },
        "evidence_requirements": {"$ref": "#/$defs/textList"},
        "human_decision_points": {"$ref": "#/$defs/textList"},
        "limitations": {"$ref": "#/$defs/textList"}
      }
    }
  }
}

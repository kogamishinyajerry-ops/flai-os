{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flai-os.local/contracts/skill_package_review_content.schema.json",
  "title": "FLAi-OS Skill Package Review Content",
  "description": "经冷读摘要核验后、仅向所属工程师按需披露的待审 Skill Package 精确文本。该投影只用于人工复核，不注册、不执行、不扩大权限。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "package_digest", "files"],
  "properties": {
    "schema_version": {"const": "skill_package_review_content.v1"},
    "package_id": {"type": "string", "pattern": "^skill_package_[0-9a-f]{24}$"},
    "package_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "files": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/skillMarkdown"},
        {"$ref": "#/$defs/provenance"},
        {"$ref": "#/$defs/skillRevision"},
        {"$ref": "#/$defs/taskPatternRevision"}
      ],
      "items": false
    }
  },
  "$defs": {
    "reviewFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "text"],
      "properties": {
        "path": {"type": "string"},
        "text": {"type": "string", "minLength": 1, "maxLength": 1048576}
      }
    },
    "skillMarkdown": {
      "allOf": [
        {"$ref": "#/$defs/reviewFile"},
        {"properties": {"path": {"const": "SKILL.md"}}}
      ]
    },
    "provenance": {
      "allOf": [
        {"$ref": "#/$defs/reviewFile"},
        {"properties": {"path": {"const": "references/provenance.json"}}}
      ]
    },
    "skillRevision": {
      "allOf": [
        {"$ref": "#/$defs/reviewFile"},
        {"properties": {"path": {"const": "references/skill-revision.json"}}}
      ]
    },
    "taskPatternRevision": {
      "allOf": [
        {"$ref": "#/$defs/reviewFile"},
        {"properties": {"path": {"const": "references/task-pattern-revision.json"}}}
      ]
    }
  }
}

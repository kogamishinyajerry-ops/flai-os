{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flai-os.local/contracts/feature_asset_map.schema.json",
  "title": "FLAi-OS Owner-Scoped Feature Asset Map",
  "description": "主会话按需读取的功能与资产投影。它不写库、不执行、不注册、不晋级。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "summary",
    "functionality",
    "assets",
    "effects"
  ],
  "properties": {
    "schema_version": {"const": "feature_asset_map.v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "owner_username", "owner_scoped", "read_only"],
      "properties": {
        "kind": {"const": "owner_scoped_cold_projection"},
        "owner_username": {"type": "string", "minLength": 1, "maxLength": 128},
        "owner_scoped": {"const": true},
        "read_only": {"const": true}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_count",
        "asset_candidate_count",
        "accepted_candidate_count",
        "skill_package_count",
        "approved_skill_package_count",
        "unresolved_reference_count"
      ],
      "properties": {
        "capability_count": {"type": "integer", "minimum": 0, "maximum": 200},
        "asset_candidate_count": {"type": "integer", "minimum": 0, "maximum": 100},
        "accepted_candidate_count": {"type": "integer", "minimum": 0, "maximum": 100},
        "skill_package_count": {"type": "integer", "minimum": 0, "maximum": 100},
        "approved_skill_package_count": {"type": "integer", "minimum": 0, "maximum": 100},
        "unresolved_reference_count": {"type": "integer", "minimum": 0}
      }
    },
    "functionality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_types", "domains", "capabilities"],
      "properties": {
        "work_types": {
          "type": "array",
          "maxItems": 200,
          "items": {"$ref": "#/$defs/facet"}
        },
        "domains": {
          "type": "array",
          "maxItems": 200,
          "items": {"$ref": "#/$defs/facet"}
        },
        "capabilities": {
          "type": "array",
          "maxItems": 200,
          "items": {"$ref": "#/$defs/capability"}
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/asset"}
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writes_database",
        "executes_work",
        "registers_asset",
        "promotes_asset"
      ],
      "properties": {
        "writes_database": {"const": false},
        "executes_work": {"const": false},
        "registers_asset": {"const": false},
        "promotes_asset": {"const": false}
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableText": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 2000},
        {"type": "null"}
      ]
    },
    "facet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "total_count"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 160},
        "total_count": {"type": "integer", "minimum": 0}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "name",
        "summary",
        "category",
        "domain",
        "specialty",
        "launch_kind",
        "status",
        "maturity",
        "requires_human_review",
        "tool_count",
        "knowledge_scope_count",
        "unresolved_reference_count",
        "mock_tool_count"
      ],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1, "maxLength": 2000},
        "name": {"$ref": "#/$defs/nullableText"},
        "summary": {"$ref": "#/$defs/nullableText"},
        "category": {"$ref": "#/$defs/nullableText"},
        "domain": {"$ref": "#/$defs/nullableText"},
        "specialty": {"$ref": "#/$defs/nullableText"},
        "launch_kind": {"type": "string", "minLength": 1, "maxLength": 2000},
        "status": {"$ref": "#/$defs/nullableText"},
        "maturity": {"$ref": "#/$defs/nullableText"},
        "requires_human_review": {
          "oneOf": [{"type": "boolean"}, {"type": "null"}]
        },
        "tool_count": {"type": "integer", "minimum": 0},
        "knowledge_scope_count": {"type": "integer", "minimum": 0},
        "unresolved_reference_count": {"type": "integer", "minimum": 0},
        "mock_tool_count": {"type": "integer", "minimum": 0}
      }
    },
    "assetLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "digest", "gate"],
      "properties": {
        "state": {"const": "not_formed"},
        "digest": {"type": "null"},
        "gate": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "taskPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "state", "digest"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "state": {"enum": ["candidate_revision", "approved_revision", "rejected_revision"]},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "state", "digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "description": {"type": "string", "minLength": 1, "maxLength": 4200},
        "state": {"enum": ["candidate_revision", "approved_revision", "rejected_revision"]},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "skillPackage": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"state": {"const": "approved"}},
            "required": ["state"]
          },
          "then": {"properties": {"reuse_eligible": {"const": true}}},
          "else": {"properties": {"reuse_eligible": {"const": false}}}
        }
      ],
      "required": [
        "id",
        "name",
        "version",
        "package_digest",
        "state",
        "reuse_eligible"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 2000},
        "name": {"type": "string", "minLength": 1, "maxLength": 2000},
        "version": {"type": "string", "minLength": 1, "maxLength": 2000},
        "package_digest": {"$ref": "#/$defs/digest"},
        "state": {"enum": ["pending_review", "approved", "rejected"]},
        "reuse_eligible": {"type": "boolean"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"state": {"const": "accepted"}},
            "required": ["state"]
          },
          "then": {
            "properties": {
              "skill_package": {"$ref": "#/$defs/skillPackage"}
            }
          },
          "else": {
            "properties": {
              "skill_package": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"state": {"const": "awaiting_human_review"}},
            "required": ["state"]
          },
          "then": {
            "properties": {
              "task_pattern": {"properties": {"state": {"const": "candidate_revision"}}},
              "skill": {"properties": {"state": {"const": "candidate_revision"}}}
            }
          }
        },
        {
          "if": {
            "properties": {"state": {"const": "accepted"}},
            "required": ["state"]
          },
          "then": {
            "properties": {
              "task_pattern": {"properties": {"state": {"const": "approved_revision"}}},
              "skill": {"properties": {"state": {"const": "approved_revision"}}}
            }
          }
        },
        {
          "if": {
            "properties": {"state": {"const": "rejected"}},
            "required": ["state"]
          },
          "then": {
            "properties": {
              "task_pattern": {"properties": {"state": {"const": "rejected_revision"}}},
              "skill": {"properties": {"state": {"const": "rejected_revision"}}}
            }
          }
        }
      ],
      "required": [
        "candidate_id",
        "candidate_digest",
        "revision",
        "state",
        "source",
        "task_pattern",
        "skill",
        "skill_package",
        "workflow",
        "agent",
        "updated_at"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1, "maxLength": 2000},
        "candidate_digest": {"$ref": "#/$defs/digest"},
        "revision": {"type": "integer", "minimum": 1},
        "state": {"enum": ["awaiting_human_review", "accepted", "rejected"]},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_id", "conversation_id", "agent_id", "finished_at"],
          "properties": {
            "task_id": {"type": "string", "minLength": 1, "maxLength": 2000},
            "conversation_id": {"type": "string", "minLength": 1, "maxLength": 2000},
            "agent_id": {"type": "string", "minLength": 1, "maxLength": 2000},
            "finished_at": {"type": "string", "minLength": 1, "maxLength": 2000}
          }
        },
        "task_pattern": {"$ref": "#/$defs/taskPattern"},
        "skill": {"$ref": "#/$defs/skill"},
        "skill_package": {
          "oneOf": [{"$ref": "#/$defs/skillPackage"}, {"type": "null"}]
        },
        "workflow": {"$ref": "#/$defs/assetLevel"},
        "agent": {"$ref": "#/$defs/assetLevel"},
        "updated_at": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    }
  }
}

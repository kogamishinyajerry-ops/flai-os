# FLAi-OS 本地/内网环境变量样板。.env 本身不入库。
# 注意：V0.1 不自动加载本文件——变量须在启动前 export（或写入服务进程环境），
# 键名以 backend/app/config.py / profiles.yaml 实际读取的为准（全部 FLAI_* 前缀）。

# SQLite 数据库文件路径（普通文件路径，非 sqlite:// URL；代码读取键 = FLAI_DB_PATH）。
# WAL 模式要求本地磁盘：禁止指向 UNC/映射网络盘（SMB 上共享内存锁不可靠）。
FLAI_DB_PATH=data/flai_os.db

# 后端端口（被占用换端口，绝不挤占已有进程；backend/app/config.py）
#FLAI_BACKEND_PORT=8620

# 单文件上传上限 MB（默认 100；backend/app/api/files.py）
#FLAI_MAX_UPLOAD_MB=100

# --- Model Gateway 上游配置 ---
# 内网 GLM 端点地址：待内网侦察，见 docs/04_Model_Gateway_Standard.md
FLAI_LLM_BASE_URL=

# 内网模型服务鉴权 Key：待内网侦察，见 docs/04_Model_Gateway_Standard.md
FLAI_LLM_API_KEY=

# reasoning profile 对应的具体模型名（如 GLM-5.1/5.2）：待内网侦察，见 docs/04_Model_Gateway_Standard.md
FLAI_LLM_MODEL_REASONING=

# fast profile 对应的具体模型名（小尺寸快速模型）：待内网侦察，见 docs/04_Model_Gateway_Standard.md
FLAI_LLM_MODEL_FAST=

# --- 本地开发/离网验证真链路（示例，非生产配置）---
# 网关走 OpenAI 兼容协议，本地可接任一兼容端点验证「导引真调 LLM 出编排方案」这条链路。
# 例：智谱 GLM（OpenAI 兼容），交互式导引用快模型 glm-4-flash（约 1–3s；重推理 glm-4.6
# 含深度思考、延迟高，复杂编排会超网关 60s 读超时，不适合交互式）：
#   FLAI_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   FLAI_LLM_API_KEY=<你的 key>
#   FLAI_LLM_MODEL_REASONING=glm-4-flash
#   FLAI_LLM_MODEL_FAST=glm-4-flash
# 生产仍以上方内网占位为准；LLM 只出草案，平台确定性校验 + 人签发的红线不因接真模型而变。
